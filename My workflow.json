      "parameters": {
        "jsCode": "const topics = $input.all();\n\n// Берём дату в московском времени\nconst now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Moscow' }));\nconst day = String(now.getDate()).padStart(2, '0');\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst year = now.getFullYear();\nconst today = `${day}.${month}.${year}`;\n\nconst todayTopic = topics.find(row => row.json.Дата && row.json.Дата.trim() === today);\n\nif (!todayTopic) {\n  return [{ json: { error: `Ищем: ${today}`, всего_тем: topics.length } }];\n}\n\nreturn [{\n  json: {\n    topic: todayTopic.json.Тема,\n    class: todayTopic.json.Класс,\n    difficulty: todayTopic.json.Сложность,\n    date: today\n  }\n}];"
      },
